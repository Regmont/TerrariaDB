@model TerrariaDB.ViewModels.Terraria.CurrencyType.CurrencyTypeDeleteViewModel

@{
    ViewData["Title"] = "Delete Currency Type";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Delete Currency Type</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Delete" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <input type="hidden" asp-for="CurrencyName" />
                    <input type="hidden" asp-for="HasRelatedItems" />

                    <div class="grid-2">
                        <div class="form-group">
                            <div class="label-text">Currency Name</div>
                            <div style="color: #f0e0c0; font-family: 'Courier New', monospace; font-size: 24px; padding: 8px 0;">
                                @Model.CurrencyName
                            </div>
                        </div>
                    </div>

                    @if (Model.HasRelatedItems)
                    {
                        <div class="terraria-alert" style="border-color: #8b3a3a; background: #3a1e1e; color: #ff6b6b;">
                            <i class="bi bi-exclamation-triangle"></i>
                            This currency type can't be deleted because there are items that use it!
                        </div>
                    }

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn @(Model.HasRelatedItems ? "table-btn-danger" : "table-btn-success")" @(Model.HasRelatedItems ? "disabled" : "")>
                            Confirm Delete
                        </button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    button:disabled, .table-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .bi {
        margin-right: 5px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
