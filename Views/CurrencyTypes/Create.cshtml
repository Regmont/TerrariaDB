@model TerrariaDB.ViewModels.Terraria.CurrencyType.CurrencyTypeCreateViewModel

@{
    ViewData["Title"] = "Create Currency Type";
}

<h1>Create Currency Type</h1>

<a asp-action="Index">Back</a>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <div>
            <label asp-for="CurrencyName"></label>
            <input asp-for="CurrencyName" />
            <span asp-validation-for="CurrencyName"></span>
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
