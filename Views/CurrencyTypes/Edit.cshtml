@model TerrariaDB.ViewModels.Terraria.CurrencyType.CurrencyTypeEditViewModel

@{
    ViewData["Title"] = "Edit Currency Type";
}

<h1>Edit Currency Type</h1>

<a asp-action="Index">Back</a>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <input type="hidden" asp-for="OriginalCurrencyName" />

    <div>
        <div>
            <label asp-for="CurrencyName"></label>
            <input asp-for="CurrencyName" />
            <span asp-validation-for="CurrencyName"></span>
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
