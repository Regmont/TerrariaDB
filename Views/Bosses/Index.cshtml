@model TerrariaDB.ViewModels.Terraria.Boss.BossIndexViewModel

@{
    ViewData["Title"] = "Bosses";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>
                    <i class="bi bi-trophy"></i> Bosses
                </h4>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        <i class="bi bi-house"></i> Home
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="table-btn table-btn-sm table-btn-success">
                            <i class="bi bi-plus-circle"></i> Create New
                        </a>
                    }
                </div>
            </div>
            <div class="table-page-body">
                @if (!Model.Bosses.Any())
                {
                    <div class="terraria-alert terraria-alert-info">
                        <i class="bi bi-info-circle"></i>
                        No bosses found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-page">
                            <thead>
                                <tr>
                                    <th>Boss</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var boss in Model.Bosses)
                                {
                                    <tr>
                                        <td>
                                            <div class="table-cell">
                                                <img src="@boss.Sprite" alt="@boss.Name" class="table-icon" />
                                                <span class="table-title">@boss.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <a asp-action="Details" asp-route-id="@boss.Name" class="table-btn table-btn-sm table-btn-info" title="Details">
                                                    Details
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    @* <a asp-action="Edit" asp-route-id="@boss.Name" class="table-btn table-btn-sm table-btn-warning" title="Edit">
                                                        Edit
                                                    </a> *@
                                                    <a asp-action="Delete" asp-route-id="@boss.Name" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                        Delete
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
