@model TerrariaDB.ViewModels.Terraria.Boss.BossDetailsViewModel

@{
    ViewData["Title"] = "Boss Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-trophy"></i> @Model.BossName
            </h4>
            <div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.BossName" class="btn btn-warning btn-sm me-2">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.BossName" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            @if (Model.Drops.Any())
            {
                <h5 class="border-bottom pb-2 mb-3">Boss Drops</h5>
                <div class="row flex-nowrap overflow-auto pb-3 mb-4" style="gap: 1rem;">
                    @foreach (var drop in Model.Drops)
                    {
                        <div class="col-auto">
                            <div class="card text-center" style="width: 100px;">
                                <img src="@drop.Sprite" class="card-img-top p-2" alt="@drop.Name" style="height: 60px; object-fit: contain;" />
                                <div class="card-body p-2">
                                    <small class="card-text text-truncate d-block">@drop.Name</small>
                                    <span class="badge bg-secondary">x@(drop.Quantity)</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.BossParts.Any())
            {
                <h5 class="border-bottom pb-2 mb-3">Boss Parts</h5>
                <div class="accordion" id="bossPartsDetailsAccordion">
                    @foreach (var part in Model.BossParts)
                    {
                        <div class="accordion-item mb-3">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#part@(part.Name.GetHashCode())">
                                    <div class="d-flex align-items-center gap-3">
                                        <strong>@part.Name</strong>
                                        <small class="text-muted">x@(part.Quantity)</small>
                                    </div>
                                </button>
                            </h2>
                            <div id="part@(part.Name.GetHashCode())" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    <p class="text-muted mb-3">@part.Description</p>

                                    <div class="row g-4">
                                        @foreach (var stage in part.Stages)
                                        {
                                            <div class="col-md-6">
                                                <div class="card h-100">
                                                    <div class="card-header bg-dark text-white">
                                                        <h6 class="mb-0">@stage.Name</h6>
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="text-center mb-3">
                                                            <img src="@stage.Sprite" alt="@stage.Name" class="img-fluid border rounded" style="max-height: 80px;" />
                                                        </div>

                                                        <div class="row text-center mb-3">
                                                            <div class="col-3">
                                                                <div class="small text-muted">Game ID</div>
                                                                <strong>@stage.EntityId</strong>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="small text-muted">HP</div>
                                                                <strong>@stage.Hp</strong>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="small text-muted">Defense</div>
                                                                <strong>@stage.Defense</strong>
                                                            </div>
                                                            <div class="col-3">
                                                                <div class="small text-muted">Contact</div>
                                                                <strong>@stage.ContactDamage</strong>
                                                            </div>
                                                        </div>

                                                        @if (stage.SummonedEnemies.Any())
                                                        {
                                                            <div class="mb-3">
                                                                <label class="small fw-bold">Spawned Enemies:</label>
                                                                <div class="row flex-nowrap overflow-auto pb-2" style="gap: 0.5rem;">
                                                                    @foreach (var enemy in stage.SummonedEnemies)
                                                                    {
                                                                        <div class="col-auto">
                                                                            <div class="text-center" style="width: 60px;">
                                                                                <img src="@enemy.Sprite" alt="@enemy.Name" class="img-fluid" style="max-height: 30px;" />
                                                                                <div class="small text-truncate">@enemy.Name</div>
                                                                                <span class="badge bg-secondary">x@(enemy.Quantity)</span>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (stage.Drops.Any())
                                                        {
                                                            <div>
                                                                <label class="small fw-bold">Drops:</label>
                                                                <div class="row flex-nowrap overflow-auto pb-2" style="gap: 0.5rem;">
                                                                    @foreach (var drop in stage.Drops)
                                                                    {
                                                                        <div class="col-auto">
                                                                            <div class="text-center" style="width: 60px;">
                                                                                <img src="@drop.Sprite" alt="@drop.Name" class="img-fluid" style="max-height: 30px;" />
                                                                                <div class="small text-truncate">@drop.Name</div>
                                                                                <span class="badge bg-secondary">x@(drop.Quantity)</span>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
