@model TerrariaDB.ViewModels.Terraria.Boss.BossDetailsViewModel

@{
    ViewData["Title"] = "Boss Details";
}

<h1>Boss Details</h1>

<div>
    <a asp-action="Index">Back</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.BossName">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.BossName">Delete</a>
    }
</div>

<div>
    <div>
        <span>@Model.BossName</span>
    </div>

    @if (Model.Drops.Any())
    {
        <div>
            <span>Boss Drop</span>
            <div style="display: flex; flex-direction: row; overflow-x: auto;">
                @foreach (var drop in Model.Drops.Take(15))
                {
                    <div>
                        <img src="@drop.Sprite" />
                        <span>@drop.Name</span>
                        <span>@drop.Quantity</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.BossParts.Any())
    {
        <div>
            <span>Boss Parts</span>
            <div>
                @foreach (var part in Model.BossParts)
                {
                    <div>
                        <div>
                            <span><strong>@part.Name</strong></span>
                            <span>@part.Description</span>
                            <span>Quantity: @part.Quantity</span>
                        </div>

                        <div style="display: flex; flex-direction: row; overflow-x: auto;">
                            @foreach (var stage in part.Stages)
                            {
                                <div>
                                    <img src="@stage.Sprite" />
                                    <span><strong>@stage.Name</strong></span>
                                    <span>HP: @stage.Hp</span>
                                    <span>Defense: @stage.Defense</span>
                                    <span>Game ID: @stage.EntityId</span>
                                    <span>Contact Damage: @stage.ContactDamage</span>

                                    @if (stage.SummonedEnemies.Any())
                                    {
                                        <div>
                                            <span>Spawned Enemies:</span>
                                            <div style="display: flex; flex-direction: row; overflow-x: auto;">
                                                @foreach (var enemy in stage.SummonedEnemies.Take(3))
                                                {
                                                    <div>
                                                        <img src="@enemy.Sprite" />
                                                        <span>@enemy.Name</span>
                                                        <span>@enemy.Quantity</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @if (stage.Drops.Any())
                                    {
                                        <div>
                                            <span>Drops:</span>
                                            <div style="display: flex; flex-direction: row; overflow-x: auto;">
                                                @foreach (var drop in stage.Drops.Take(3))
                                                {
                                                    <div>
                                                        <img src="@drop.Sprite" />
                                                        <span>@drop.Name</span>
                                                        <span>@drop.Quantity</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
