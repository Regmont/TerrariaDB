@model TerrariaDB.ViewModels.Terraria.Boss.BossDetailsViewModel

@{
    ViewData["Title"] = "Boss Details";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>
                    <i class="bi bi-trophy"></i> @Model.BossName
                </h4>
                <div class="horizontal-container">
                    <a asp-action="Index" class="table-btn table-btn-sm">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        @* <a asp-action="Edit" asp-route-id="@Model.BossName" class="table-btn table-btn-sm table-btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a> *@
                        <a asp-action="Delete" asp-route-id="@Model.BossName" class="table-btn table-btn-sm table-btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                </div>
            </div>
            <div class="table-page-body">
                @if (Model.Drops.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Boss Drops</div>
                        <div class="horizontal-container" style="overflow-x: auto; padding-bottom: 10px; gap: 15px;">
                            @foreach (var drop in Model.Drops)
                            {
                                <div class="terraria-card" style="min-width: 100px; padding: 10px; cursor: default;">
                                    <div class="card-icon" style="width: 60px; height: 60px;">
                                        <img src="@drop.Sprite" alt="@drop.Name" class="@(string.IsNullOrEmpty(drop.Sprite) ? "small-img" : "")" />
                                    </div>
                                    <div class="card-title" style="font-size: 10px; margin-top: 10px;">@drop.Name</div>
                                    <div class="entity-badge" style="margin-top: 5px;">x@(drop.Quantity)</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.BossParts.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Boss Parts</div>
                        <div style="display: flex; flex-direction: column; gap: 20px;">
                            @foreach (var part in Model.BossParts)
                            {
                                <div class="terraria-card" style="padding: 0; cursor: default; overflow: hidden;">
                                    <div style="background: #2a1e14; border-bottom: 2px solid #8b6b4d; padding: 12px 15px;">
                                        <div style="display: flex; align-items: center; gap: 15px;">
                                            <strong style="color: #ffd700; font-size: 16px; text-shadow: 2px 2px 0 #8b4513;">@part.Name</strong>
                                            <span class="entity-badge">x@(part.Quantity)</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(part.Description))
                                        {
                                            <div class="table-subtitle" style="margin-top: 8px;">@part.Description</div>
                                        }
                                    </div>

                                    <div style="padding: 15px;">
                                        <div class="grid-2">
                                            @foreach (var stage in part.Stages)
                                            {
                                                <div class="terraria-card" style="padding: 15px; cursor: default; margin: 0;">
                                                    <div style="
                                                                    display: flex;
                                                                    align-items: center;
                                                                    background: #2a1e14;
                                                                    border-bottom: 2px solid #8b6b4d;
                                                                    margin-bottom: 15px;
                                                                    padding: 8px 15px;
                                                                    width: 100%;
                                                                    box-sizing: border-box;
                                                                ">
                                                        <h6 style="margin: 0; font-size: 14px; color: #ffd700; text-shadow: 2px 2px 0 #8b4513;">@stage.Name</h6>
                                                    </div>

                                                    <div class="card-icon" style="width: 80px; height: 80px; margin-bottom: 15px; align-self: center;">
                                                        <img src="@stage.Sprite" alt="@stage.Name" class="@(string.IsNullOrEmpty(stage.Sprite) ? "small-img" : "")" />
                                                    </div>

                                                    <div class="grid-4" style="gap: 5px; width: 100%; margin-bottom: 10px;">
                                                        <div style="text-align: center;">
                                                            <div class="table-subtitle">Game ID</div>
                                                            <div class="table-title" style="font-size: 12px;">@stage.EntityId</div>
                                                        </div>
                                                        <div style="text-align: center;">
                                                            <div class="table-subtitle">HP</div>
                                                            <div class="table-title" style="font-size: 12px;">@stage.Hp</div>
                                                        </div>
                                                        <div style="text-align: center;">
                                                            <div class="table-subtitle">Defense</div>
                                                            <div class="table-title" style="font-size: 12px;">@stage.Defense</div>
                                                        </div>
                                                        <div style="text-align: center;">
                                                            <div class="table-subtitle">Contact</div>
                                                            <div class="table-title" style="font-size: 12px;">@stage.ContactDamage</div>
                                                        </div>
                                                    </div>

                                                    @if (stage.SummonedEnemies.Any())
                                                    {
                                                        <div style="margin-bottom: 10px;">
                                                            <div class="table-subtitle" style="margin-bottom: 10px;">Spawned Enemies:</div>
                                                            <div class="horizontal-container" style="overflow-x: auto; padding-bottom: 5px; gap: 10px;">
                                                                @foreach (var enemy in stage.SummonedEnemies)
                                                                {
                                                                    <div style="min-width: 60px; text-align: center;">
                                                                        <div class="card-icon" style="width: 30px; height: 30px; margin: 0 auto;">
                                                                            <img src="@enemy.Sprite" alt="@enemy.Name" class="@(string.IsNullOrEmpty(enemy.Sprite) ? "small-img" : "")" />
                                                                        </div>
                                                                        <div class="table-subtitle" style="font-size: 8px; margin-top: 5px;">@enemy.Name</div>
                                                                        <div class="entity-badge" style="font-size: 8px; padding: 2px 4px;">x@(enemy.Quantity)</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }

                                                    @if (stage.Drops.Any())
                                                    {
                                                        <div>
                                                            <div class="table-subtitle" style="margin-bottom: 10px;">Drops:</div>
                                                            <div class="horizontal-container" style="overflow-x: auto; padding-bottom: 5px; gap: 10px;">
                                                                @foreach (var drop in stage.Drops)
                                                                {
                                                                    <div style="min-width: 60px; text-align: center;">
                                                                        <div class="card-icon" style="width: 30px; height: 30px; margin: 0 auto;">
                                                                            <img src="@drop.Sprite" alt="@drop.Name" class="@(string.IsNullOrEmpty(drop.Sprite) ? "small-img" : "")" />
                                                                        </div>
                                                                        <div class="table-subtitle" style="font-size: 8px; margin-top: 5px;">@drop.Name</div>
                                                                        <div class="entity-badge" style="font-size: 8px; padding: 2px 4px;">x@(drop.Quantity)</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bi {
        margin-right: 5px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .card-icon {
        background: #2a1e14;
        border: 3px solid #6b4f35;
        padding: 2px;
        box-shadow: inset 0 0 0 2px #1a140e;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .card-icon img {
            max-height: 100%;
            max-width: 100%;
        }

    .small-img {
        height: 50% !important;
    }

    .terraria-card {
        cursor: default;
        position: relative;
    }

        .terraria-card:hover {
            transform: none !important;
            box-shadow: 0 8px 0 #4a3c2c !important;
            border-color: #8b6b4d !important;
            background: linear-gradient(145deg, #3a2c20 0%, #2a1e14 100%) !important;
        }

    .table-title {
        font-weight: bold;
        color: #ffd700;
        text-shadow: 2px 2px 0 #8b4513;
        letter-spacing: 1px;
    }

    .table-subtitle {
        color: #c0a88c;
        font-size: 12px;
        text-transform: uppercase;
    }

    .entity-badge {
        padding: 3px 8px;
        box-shadow: 0 2px 0 #4a3c2c;
        display: inline-block;
        background: #2a1e14;
        border: 2px solid #8b6b4d;
        font-size: 12px;
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .form-section {
        margin-bottom: 30px;
    }

        .form-section:last-child {
            margin-bottom: 0;
        }

    .form-section-title {
        color: #ffd700;
        font-family: 'Courier New', monospace;
        font-size: 20px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-shadow: 2px 2px 0 #8b4513;
    }

    @@media (max-width: 768px) {
        .grid-2 {
            grid-template-columns: 1fr;
        }

        .grid-4 {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
