@model TerrariaDB.ViewModels.Terraria.Boss.BossCreateViewModel

@{
    ViewData["Title"] = "Create Boss";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Create New Boss</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <div class="grid-2 mb-20">
                        <div class="form-group">
                            <div class="label-text">Boss Name</div>
                            <input asp-for="BossName" type="text" placeholder="Enter boss name" />
                            <span asp-validation-for="BossName" class="validation-message"></span>
                        </div>
                        <div class="form-group">
                            <div class="label-text">Summon Item</div>
                            <select asp-for="SummonItemId" asp-items="Model.AvailableItems">
                                <option value="">-- No summon item --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-card">
                        <h5>Boss Drops</h5>
                        <div class="grid-5">
                            @for (int i = 0; i < 15; i++)
                            {
                                <div class="form-group">
                                    <select asp-for="BossDrops[i].ItemId" asp-items="Model.AvailableItems" data-val="false">
                                        <option value="">-- Item --</option>
                                    </select>
                                    <div class="horizontal-container" style="margin-top: 5px;">
                                        <input asp-for="BossDrops[i].Quantity" type="number" min="1" max="150" value="1" />
                                        <button type="button" class="table-btn table-btn-sm clear-boss-drop" data-index="@i">Clear</button>
                                    </div>
                                    <span asp-validation-for="BossDrops[i].Quantity" class="validation-message"></span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">Boss Parts</div>
                        <div class="grid-2">
                            @for (int i = 0; i < 5; i++)
                            {
                                <div class="item-card boss-part" data-part="@i">
                                    <div class="item-card-header">Part @(i + 1)</div>

                                    <div class="form-group">
                                        <div class="label-text">Part Name</div>
                                        @if (i == 0)
                                        {
                                            <input asp-for="BossParts[i].PartName" type="text" />
                                            <span asp-validation-for="BossParts[i].PartName" class="validation-message"></span>
                                        }
                                        else
                                        {
                                            <input asp-for="BossParts[i].PartName" type="text" data-val="false" />
                                        }
                                    </div>

                                    <div class="form-group">
                                        <div class="label-text">Description</div>
                                        <input asp-for="BossParts[i].Description" type="text" />
                                        <span asp-validation-for="BossParts[i].Description" class="validation-message"></span>
                                    </div>

                                    <div class="form-group">
                                        <div class="label-text">Quantity</div>
                                        <input asp-for="BossParts[i].Quantity" type="number" min="1" max="50" value="1" />
                                        <span asp-validation-for="BossParts[i].Quantity" class="validation-message"></span>
                                    </div>

                                    <div class="grid-2" style="margin-top: 10px;">
                                        @for (int j = 0; j < 2; j++)
                                        {
                                            <div class="item-card boss-stage" data-part="@i" data-stage="@j" style="padding: 8px;">
                                                <div style="color: #c0a88c; margin-bottom: 8px;">Stage @(j + 1)</div>

                                                <div class="form-group">
                                                    <div class="label-text">Sprite URL</div>
                                                    @if (i == 0 && j == 0)
                                                    {
                                                        <input asp-for="BossParts[i].Stages[j].Sprite" type="text" />
                                                        <span asp-validation-for="BossParts[i].Stages[j].Sprite" class="validation-message"></span>
                                                    }
                                                    else
                                                    {
                                                        <input asp-for="BossParts[i].Stages[j].Sprite" type="text" data-val="false" />
                                                    }
                                                </div>

                                                <div class="grid-2" style="gap: 5px;">
                                                    <div class="form-group">
                                                        <div class="label-text">HP</div>
                                                        <input asp-for="BossParts[i].Stages[j].Hp" type="number" min="0" max="150000" value="0" />
                                                        <span asp-validation-for="BossParts[i].Stages[j].Hp" class="validation-message"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="label-text">Defense</div>
                                                        <input asp-for="BossParts[i].Stages[j].Defense" type="number" min="0" max="100" value="0" />
                                                        <span asp-validation-for="BossParts[i].Stages[j].Defense" class="validation-message"></span>
                                                    </div>
                                                </div>

                                                <div class="grid-2" style="gap: 5px;">
                                                    <div class="form-group">
                                                        <div class="label-text">Game ID</div>
                                                        <input asp-for="BossParts[i].Stages[j].EntityId" type="number" value="0" />
                                                        <span asp-validation-for="BossParts[i].Stages[j].EntityId" class="validation-message"></span>
                                                    </div>
                                                    <div class="form-group">
                                                        <div class="label-text">Contact Dmg</div>
                                                        <input asp-for="BossParts[i].Stages[j].ContactDamage" type="number" min="0" max="500" value="0" />
                                                        <span asp-validation-for="BossParts[i].Stages[j].ContactDamage" class="validation-message"></span>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <div class="label-text">Spawned Enemies</div>
                                                    @for (int k = 0; k < 3; k++)
                                                    {
                                                        <div style="margin-bottom: 5px;">
                                                            <select asp-for="BossParts[i].Stages[j].SpawnedEnemies[k].EnemyId" asp-items="Model.AvailableEnemies" data-val="false">
                                                                <option value="">-- Enemy --</option>
                                                            </select>
                                                            <div class="horizontal-container" style="margin-top: 2px;">
                                                                <input asp-for="BossParts[i].Stages[j].SpawnedEnemies[k].Quantity" type="number" min="1" max="50" value="1" />
                                                                <button type="button" class="table-btn table-btn-sm clear-spawned-enemy" data-part="@i" data-stage="@j" data-enemy="@k">Clear</button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <div class="form-group">
                                                    <div class="label-text">Drops</div>
                                                    @for (int k = 0; k < 3; k++)
                                                    {
                                                        <div style="margin-bottom: 5px;">
                                                            <select asp-for="BossParts[i].Stages[j].Drops[k].ItemId" asp-items="Model.AvailableItems" data-val="false">
                                                                <option value="">-- Item --</option>
                                                            </select>
                                                            <div class="horizontal-container" style="margin-top: 2px;">
                                                                <input asp-for="BossParts[i].Stages[j].Drops[k].Quantity" type="number" min="1" max="50" value="1" />
                                                                <button type="button" class="table-btn table-btn-sm clear-stage-drop" data-part="@i" data-stage="@j" data-drop="@k">Clear</button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>

                                                <button type="button" class="table-btn table-btn-sm table-btn-danger w-100 clear-stage" data-part="@i" data-stage="@j" style="margin-top: 5px;">Clear Stage</button>
                                            </div>
                                        }
                                    </div>

                                    <button type="button" class="table-btn table-btn-sm table-btn-danger w-100 clear-part" data-part="@i" style="margin-top: 10px;">Clear Part</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn table-btn-success">Save Boss</button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    input, input:focus, input:active, input:hover,
    select, select:focus, select:active, select:hover {
        background-color: #1a1f2e !important;
        border: 2px solid #8b6b4d !important;
        color: #ffd700 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 16px !important;
        width: 100% !important;
        box-sizing: border-box !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5) !important;
        outline: none !important;
    }

        select option {
            background-color: #1a1f2e !important;
            color: #ffd700 !important;
        }

        input:focus, select:focus {
            border-color: #c0a88c !important;
            background-color: #141229 !important;
        }

            input:focus:not(:placeholder-shown),
            select:focus:not(:placeholder-shown) {
                background-color: #0f1420 !important;
                border-color: #ffd700 !important;
            }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active,
        select:-webkit-autofill,
        select:-webkit-autofill:hover,
        select:-webkit-autofill:focus,
        select:-webkit-autofill:active {
            background-color: #0f1420 !important;
            border-color: #ffd700 !important;
            -webkit-text-fill-color: #ffd700 !important;
            -webkit-box-shadow: 0 0 0px 1000px #0f1420 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-boss-drop, .clear-spawned-enemy, .clear-stage-drop, .clear-stage, .clear-part').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();

                if (this.classList.contains('clear-boss-drop')) {
                    const group = this.closest('.form-group');
                    group.querySelector('select').selectedIndex = 0;
                    group.querySelector('input[type="number"]').value = 1;
                }

                else if (this.classList.contains('clear-spawned-enemy') || this.classList.contains('clear-stage-drop')) {
                    const group = this.closest('[style*="margin-bottom"]');
                    group.querySelector('select').selectedIndex = 0;
                    group.querySelector('input[type="number"]').value = 1;
                }

                else if (this.classList.contains('clear-stage')) {
                    const stage = this.closest('.boss-stage');
                    stage.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
                    stage.querySelectorAll('input[type="number"]').forEach(i => i.value = i.min || 0);
                    stage.querySelectorAll('input[type="text"]').forEach(i => i.value = '');
                }

                else if (this.classList.contains('clear-part')) {
                    const part = this.closest('.boss-part');
                    part.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
                    part.querySelectorAll('input[type="number"]').forEach(i => {
                        if (i.name.includes('Quantity') && i.min) {
                            i.value = 1;
                        } else {
                            i.value = i.min || 0;
                        }
                    });
                    part.querySelectorAll('input[type="text"]').forEach(i => i.value = '');
                }
            });
        });
    </script>
}
