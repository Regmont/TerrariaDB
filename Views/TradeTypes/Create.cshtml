@model TerrariaDB.ViewModels.Terraria.TradeType.TradeTypeCreateViewModel

@{
    ViewData["Title"] = "Create Trade Type";
}

<h1>Create Trade Type</h1>

<a asp-action="Index">Back</a>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <div>
            <label asp-for="TradeTypeName"></label>
            <input asp-for="TradeTypeName" />
            <span asp-validation-for="TradeTypeName"></span>
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
