@model TerrariaDB.ViewModels.Terraria.TradeType.TradeTypeIndexViewModel

@{
    ViewData["Title"] = "Trade Types";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Trade Types</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="table-btn table-btn-sm table-btn-success">
                            Create New
                        </a>
                    }
                </div>
            </div>
            <div class="table-page-body">
                @if (!Model.TradeTypeNames.Any())
                {
                    <div class="terraria-alert terraria-alert-info">
                        No trade types found. Click "Create New" to add one.
                    </div>
                }
                else
                {
                    <div class="scrollable-table">
                        <table class="table-page">
                            <thead>
                                <tr>
                                    <th>Trade Type Name</th>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <th class="text-end">Actions</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tradeTypeName in Model.TradeTypeNames)
                                {
                                    <tr>
                                        <td>
                                            <span style="color: #f0e0c0;">@tradeTypeName</span>
                                        </td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <td>
                                                <div class="table-actions">
                                                    <a asp-action="Delete" asp-route-id="@tradeTypeName" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                        Delete
                                                    </a>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
