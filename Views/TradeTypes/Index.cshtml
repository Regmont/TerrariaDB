@model TerrariaDB.ViewModels.Terraria.TradeType.TradeTypeIndexViewModel

@{
    ViewData["Title"] = "Trade Types";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-arrow-left-right"></i> Trade Types
            </h4>
            <div>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-house"></i> Home
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle"></i> Create New
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!Model.TradeTypeNames.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    No trade types found. Click "Create New" to add one.
                </div>
            }
            else
            {
                <div style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover">
                        <thead class="sticky-top bg-white">
                            <tr>
                                <th>Trade Type Name</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="text-end" style="width: 150px;">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tradeTypeName in Model.TradeTypeNames)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <span class="badge bg-info text-dark">@tradeTypeName</span>
                                    </td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Edit" asp-route-id="@tradeTypeName" class="btn btn-warning">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@tradeTypeName" class="btn btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
