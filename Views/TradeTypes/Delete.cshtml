@model TerrariaDB.ViewModels.Terraria.TradeType.TradeTypeDeleteViewModel

@{
    ViewData["Title"] = "Delete Trade Type";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Delete Trade Type</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Delete" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <input type="hidden" asp-for="TradeTypeName" />
                    <input type="hidden" asp-for="HasRelatedTrades" />

                    <div class="grid-2">
                        <div class="form-group">
                            <div class="label-text">Trade Type Name</div>
                            <div style="color: #f0e0c0; font-family: 'Courier New', monospace; font-size: 18px; padding: 8px 0;">
                                @Model.TradeTypeName
                            </div>
                        </div>
                    </div>

                    @if (Model.HasRelatedTrades)
                    {
                        <div class="terraria-alert" style="border-color: #8b3a3a; background: #3a1e1e; color: #ff6b6b;">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Cannot delete</strong> - This trade type is used by existing trades!
                        </div>
                    }

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn @(Model.HasRelatedTrades ? "table-btn-danger" : "table-btn-success")" @(Model.HasRelatedTrades ? "disabled" : "")>
                            Confirm Delete
                        </button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    button:disabled, .table-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .bi {
        margin-right: 5px;
    }

    .terraria-alert strong {
        color: #ffd700;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
