@model TerrariaDB.ViewModels.Terraria.TradeType.TradeTypeDeleteViewModel

@{
    ViewData["Title"] = "Delete Trade Type";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Trade Type</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Are you sure you want to delete this trade type?
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Trade Type Name</label>
                        <div class="form-control bg-light">@Model.TradeTypeName</div>
                    </div>

                    @if (Model.HasRelatedTrades)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle"></i>
                            <strong>Cannot delete</strong> - This trade type is used by existing trades!
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="TradeTypeName" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger" disabled="@Model.HasRelatedTrades">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
