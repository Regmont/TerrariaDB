@model TerrariaDB.ViewModels.Terraria.Recipe.RecipeEditViewModel

@{
    ViewData["Title"] = "Edit Recipe";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Edit Recipe
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="RecipeId" />

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Result</h5>
                                        <div class="mb-3">
                                            <label asp-for="ResultItemId" class="form-label fw-bold">Result Item</label>
                                            <select asp-for="ResultItemId" asp-items="Model.AvailableItems" class="form-select">
                                                <option value="">-- Select item --</option>
                                            </select>
                                            <span asp-validation-for="ResultItemId" class="text-danger"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="ResultItemQuantity" class="form-label fw-bold">Result Quantity</label>
                                            <input asp-for="ResultItemQuantity" type="number" class="form-control" min="1" max="100" />
                                            <span asp-validation-for="ResultItemQuantity" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Crafting Station</h5>
                                        <div class="mb-3">
                                            <label asp-for="CraftingStationName" class="form-label fw-bold">Crafting Station (Optional)</label>
                                            <select asp-for="CraftingStationName" asp-items="Model.AvailableCraftingStations" class="form-select">
                                                <option value="">-- None --</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Ingredients</h5>
                                <span asp-validation-for="Ingredients" class="text-danger d-block mb-3"></span>
                                <div class="row g-3" id="ingredientsContainer">
                                    @for (int i = 0; i < 8; i++)
                                    {
                                        <div class="col-md-3 ingredient-item" data-index="@i">
                                            <div class="card h-100">
                                                <div class="card-body p-2">
                                                    <select asp-for="Ingredients[i].ItemId" asp-items="Model.AvailableItems" class="form-select form-select-sm mb-2">
                                                        <option value="">-- Item --</option>
                                                    </select>
                                                    <input asp-for="Ingredients[i].Quantity" type="number" class="form-control form-control-sm mb-2" placeholder="Qty" min="1" max="10000" />
                                                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 clear-ingredient" data-index="@i">
                                                        <i class="bi bi-eraser"></i> Clear
                                                    </button>
                                                    <span asp-validation-for="Ingredients[i].ItemId" class="text-danger small"></span>
                                                    <span asp-validation-for="Ingredients[i].Quantity" class="text-danger small"></span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-ingredient').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const ingredientDiv = document.querySelector(`.ingredient-item[data-index="${index}"]`);

                const select = ingredientDiv.querySelector('select');
                const input = ingredientDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = 1;
            });
        });
    </script>
}
