@model TerrariaDB.ViewModels.Terraria.Recipe.RecipeEditViewModel

@{
    ViewData["Title"] = "Edit Recipe";
}

<h1>Edit Recipe</h1>

<a asp-action="Index">Back</a>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="RecipeId" />

    <div>
        <div>
            <label asp-for="ResultItemId">Result Item:</label>
            <select asp-for="ResultItemId" asp-items="Model.AvailableItems"></select>
            <span asp-validation-for="ResultItemId" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div>
            <label asp-for="ResultItemQuantity">Result quantity:</label>
            <input asp-for="ResultItemQuantity" type="number" />
            <span asp-validation-for="ResultItemQuantity" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div>
            <label asp-for="CraftingStationName">Crafting Station:</label>
            <select asp-for="CraftingStationName" asp-items="Model.AvailableCraftingStations"></select>
        </div>
    </div>

    <div>
        <label>Ingredients</label>
        <span asp-validation-for="Ingredients" class="text-danger"></span>
        <div style="display: flex; flex-direction: row;">
            @for (int i = 0; i < 8; i++)
            {
                <div class="ingredient-item" data-index="@i">
                    <select asp-for="Ingredients[i].ItemId" asp-items="Model.AvailableItems"></select>
                    <input asp-for="Ingredients[i].Quantity" type="number" />
                    <span asp-validation-for="Ingredients[i].ItemId" class="text-danger"></span>
                    <span asp-validation-for="Ingredients[i].Quantity" class="text-danger"></span>
                    <button type="button" class="clear-ingredient" data-index="@i">Clear</button>
                </div>
            }
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-ingredient').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const ingredientDiv = document.querySelector(`.ingredient-item[data-index="${index}"]`);

                const select = ingredientDiv.querySelector('select');
                const input = ingredientDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = input.getAttribute('value') || '1';
            });
        });
    </script>
}
