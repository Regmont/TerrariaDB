@model TerrariaDB.ViewModels.Terraria.Recipe.RecipeDeleteViewModel

@{
    ViewData["Title"] = "Delete Recipe";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Delete Recipe</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <div class="terraria-alert" style="border-color: #8b3a3a; background: #3a1e1e; color: #ff6b6b; margin-bottom: 20px;">
                    <i class="bi bi-exclamation-triangle"></i>
                    Are you sure you want to delete this recipe?
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="RecipeId" />
                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn table-btn-danger">
                            Confirm Delete
                        </button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bi {
        margin-right: 5px;
    }
</style>
