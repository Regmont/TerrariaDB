@model TerrariaDB.ViewModels.Terraria.Recipe.RecipeCreateViewModel

@{
    ViewData["Title"] = "Create Recipe";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Create New Recipe</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <div class="grid-2 mb-20">
                        <div class="form-card">
                            <h5>Result</h5>
                            <div class="form-group">
                                <div class="label-text">Result Item</div>
                                <select asp-for="ResultItemId" asp-items="Model.AvailableItems">
                                    <option value="">-- Select item --</option>
                                </select>
                                <span asp-validation-for="ResultItemId" class="validation-message"></span>
                            </div>
                            <div class="form-group">
                                <div class="label-text">Result Quantity</div>
                                <input asp-for="ResultItemQuantity" type="number" min="1" max="100" value="1" />
                                <span asp-validation-for="ResultItemQuantity" class="validation-message"></span>
                            </div>
                        </div>

                        <div class="form-card">
                            <h5>Crafting Station</h5>
                            <div class="form-group">
                                <div class="label-text">Crafting Station</div>
                                <select asp-for="CraftingStationName" asp-items="Model.AvailableCraftingStations">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-card">
                        <h5>Ingredients</h5>
                        <span asp-validation-for="Ingredients" class="validation-message d-block mb-3"></span>
                        <div class="grid-2">
                            @for (int i = 0; i < 8; i++)
                            {
                                <div class="ingredient-item" data-index="@i">
                                    <div class="item-card ingredient-item" data-index="@i" style="padding: 15px;">
                                        <div class="form-group" style="margin-bottom: 15px;">
                                            <div class="label-text">Item</div>
                                            <select asp-for="Ingredients[i].ItemId" asp-items="Model.AvailableItems" data-val="@(i == 0 ? "true" : "false")">
                                                <option value="">-- Select item --</option>
                                            </select>
                                            @if (i == 0)
                                            {
                                                <span asp-validation-for="Ingredients[i].ItemId" class="validation-message"></span>
                                            }
                                        </div>
                                        <div class="form-group" style="margin-bottom: 15px;">
                                            <div class="label-text">Quantity</div>
                                            <input asp-for="Ingredients[i].Quantity" type="number" placeholder="Qty" min="1" max="10000" value="1" />
                                            <span asp-validation-for="Ingredients[i].Quantity" class="validation-message"></span>
                                        </div>
                                        <button type="button" class="table-btn table-btn-sm w-100 clear-ingredient" data-index="@i">Clear</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn table-btn-success">Save Recipe</button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    input, input:focus, input:active, input:hover,
    select, select:focus, select:active, select:hover {
        background-color: #1a1f2e !important;
        border: 2px solid #8b6b4d !important;
        color: #ffd700 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 16px !important;
        width: 200px !important;
        box-sizing: border-box !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5) !important;
        outline: none !important;
    }

        select option {
            background-color: #1a1f2e !important;
            color: #ffd700 !important;
        }

        input:focus, select:focus {
            border-color: #c0a88c !important;
            background-color: #141229 !important;
        }

            input:focus:not(:placeholder-shown),
            select:focus:not(:placeholder-shown) {
                background-color: #0f1420 !important;
                border-color: #ffd700 !important;
            }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active,
        select:-webkit-autofill,
        select:-webkit-autofill:hover,
        select:-webkit-autofill:focus,
        select:-webkit-autofill:active {
            background-color: #0f1420 !important;
            border-color: #ffd700 !important;
            -webkit-text-fill-color: #ffd700 !important;
            -webkit-box-shadow: 0 0 0px 1000px #0f1420 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    .d-block {
        display: block;
    }

    .mb-3 {
        margin-bottom: 15px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-ingredient').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const ingredientDiv = document.querySelector(`.ingredient-item[data-index="${index}"]`);

                const select = ingredientDiv.querySelector('select');
                const input = ingredientDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = 1;
            });
        });
    </script>
}
