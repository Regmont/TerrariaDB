@model TerrariaDB.ViewModels.Terraria.Enemy.EnemyCreateViewModel

<h1>Create Enemy</h1>

<a asp-action="Index">Back</a>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" type="text" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div>
            <label asp-for="Description"></label>
            <input asp-for="Description" type="text" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div style="display: flex; flex-direction: row;">
            @for (int i = 0; i < 3; i++)
            {
                <div class="enemy-stage" data-stage="@i">
                    <div>
                        <label asp-for="Stages[i].Sprite">Sprite</label>
                        <input asp-for="Stages[i].Sprite" type="text" />
                        <span asp-validation-for="Stages[i].Sprite" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Stages[i].Hp">HP</label>
                        <input asp-for="Stages[i].Hp" type="number" />
                        <span asp-validation-for="Stages[i].Hp" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Stages[i].Defense">Defense</label>
                        <input asp-for="Stages[i].Defense" type="number" />
                        <span asp-validation-for="Stages[i].Defense" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Stages[i].EntityId">Game ID</label>
                        <input asp-for="Stages[i].EntityId" type="number" />
                        <span asp-validation-for="Stages[i].EntityId" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Stages[i].ContactDamage">Contact Damage</label>
                        <input asp-for="Stages[i].ContactDamage" type="number" />
                        <span asp-validation-for="Stages[i].ContactDamage" class="text-danger"></span>
                    </div>
                    <div>
                        <label>Drop</label>
                        <div style="display: flex; flex-direction: row;">
                            @for (int j = 0; j < 5; j++)
                            {
                                <div class="enemy-drop" data-stage="@i" data-drop="@j">
                                    <select asp-for="Stages[i].Drops[j].ItemId" asp-items="Model.AvailableItems"></select>
                                    <input asp-for="Stages[i].Drops[j].Quantity" type="number" />
                                    <span asp-validation-for="Stages[i].Drops[j].Quantity" class="text-danger"></span>
                                    <button type="button" class="clear-enemy-drop" data-stage="@i" data-drop="@j">Clear</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-enemy-drop').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const stage = this.getAttribute('data-stage');
                const drop = this.getAttribute('data-drop');
                const dropDiv = document.querySelector(`.enemy-drop[data-stage="${stage}"][data-drop="${drop}"]`);

                const select = dropDiv.querySelector('select');
                const input = dropDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = input.getAttribute('value') || '1';
            });
        });
    </script>
}
