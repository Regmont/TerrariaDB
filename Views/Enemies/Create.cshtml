@model TerrariaDB.ViewModels.Terraria.Enemy.EnemyCreateViewModel

@{
    ViewData["Title"] = "Create Enemy";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Create New Enemy
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" type="text" class="form-control" placeholder="Enter enemy name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <input asp-for="Description" type="text" class="form-control" placeholder="Enter description" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row g-4">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="col-md-4">
                                    <div class="card border-primary h-100">
                                        <div class="card-header bg-primary bg-opacity-10">
                                            <h5 class="mb-0">Stage @(i + 1)</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-3">
                                                <label asp-for="Stages[i].Sprite" class="form-label small fw-bold">Sprite URL</label>
                                                <input asp-for="Stages[i].Sprite" type="text" class="form-control form-control-sm" />
                                                <span asp-validation-for="Stages[i].Sprite" class="text-danger small"></span>
                                            </div>

                                            <div class="row mb-3">
                                                <div class="col-6">
                                                    <label asp-for="Stages[i].Hp" class="form-label small fw-bold">HP</label>
                                                    <input asp-for="Stages[i].Hp" type="number" class="form-control form-control-sm" min="0" max="30000" value="0" />
                                                    <span asp-validation-for="Stages[i].Hp" class="text-danger small"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Stages[i].Defense" class="form-label small fw-bold">Defense</label>
                                                    <input asp-for="Stages[i].Defense" type="number" class="form-control form-control-sm" min="0" max="10000" value="0" />
                                                    <span asp-validation-for="Stages[i].Defense" class="text-danger small"></span>
                                                </div>
                                            </div>

                                            <div class="row mb-3">
                                                <div class="col-6">
                                                    <label asp-for="Stages[i].EntityId" class="form-label small fw-bold">Game ID</label>
                                                    <input asp-for="Stages[i].EntityId" type="number" class="form-control form-control-sm" />
                                                    <span asp-validation-for="Stages[i].EntityId" class="text-danger small"></span>
                                                </div>
                                                <div class="col-6">
                                                    <label asp-for="Stages[i].ContactDamage" class="form-label small fw-bold">Contact Dmg</label>
                                                    <input asp-for="Stages[i].ContactDamage" type="number" class="form-control form-control-sm" min="0" max="1000" value="0" />
                                                    <span asp-validation-for="Stages[i].ContactDamage" class="text-danger small"></span>
                                                </div>
                                            </div>

                                            <div>
                                                <label class="form-label small fw-bold">Drops</label>
                                                <div class="row g-2">
                                                    @for (int j = 0; j < 5; j++)
                                                    {
                                                        <div class="col-12 enemy-drop" data-stage="@i" data-drop="@j">
                                                            <div class="input-group input-group-sm">
                                                                <select asp-for="Stages[i].Drops[j].ItemId" asp-items="Model.AvailableItems" class="form-select">
                                                                    <option value="">-- Item --</option>
                                                                </select>
                                                                <input asp-for="Stages[i].Drops[j].Quantity" type="number" class="form-control" style="width: 70px;" min="1" max="50" value="1" />
                                                                <button type="button" class="btn btn-outline-secondary clear-enemy-drop" data-stage="@i" data-drop="@j">
                                                                    <i class="bi bi-eraser"></i>
                                                                </button>
                                                            </div>
                                                            <span asp-validation-for="Stages[i].Drops[j].Quantity" class="text-danger small"></span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Enemy
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-enemy-drop').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const stage = this.getAttribute('data-stage');
                const drop = this.getAttribute('data-drop');
                const dropDiv = this.closest('.enemy-drop');

                const select = dropDiv.querySelector('select');
                const input = dropDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = 1;
            });
        });
    </script>
}
