@model TerrariaDB.ViewModels.Terraria.Entity.EntityIndexViewModel

@{
    ViewData["Title"] = "Entities";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>All Entities</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                @if (!Model.Entities.Any())
                {
                    <div class="terraria-alert terraria-alert-info">
                        No entities found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-page">
                            <thead>
                                <tr>
                                    <th>Entity</th>
                                    <th>Type</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entity in Model.Entities)
                                {
                                    <tr>
                                        <td>
                                            <div class="table-cell">
                                                <img src="@entity.Sprite" alt="@entity.Name" class="table-icon" />
                                                <div>
                                                    <div class="table-title">@entity.Name</div>
                                                    <small class="table-subtitle">Game ID: @entity.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @{
                                                string badgeClass = entity.Type switch
                                                {
                                                    "BossPart" => "table-btn-info",
                                                    "Enemy" => "table-btn-warning",
                                                    "TownNpc" => "table-btn-success",
                                                    _ => "table-btn"
                                                };
                                            }
                                            <span class="table-btn table-btn-sm entity-badge">@entity.Type</span>
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                @if (entity.Type == "BossPart")
                                                {
                                                    <a asp-controller="Boss" asp-action="Details" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-info" title="Details">
                                                        Details
                                                    </a>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-controller="Boss" asp-action="Edit" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-warning" title="Edit">
                                                            Edit
                                                        </a>
                                                        <a asp-controller="Boss" asp-action="Delete" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                            Delete
                                                        </a>
                                                    }
                                                }
                                                else if (entity.Type == "Enemy")
                                                {
                                                    <a asp-controller="Enemy" asp-action="Details" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-info" title="Details">
                                                        Details
                                                    </a>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-controller="Enemy" asp-action="Edit" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-warning" title="Edit">
                                                            Edit
                                                        </a>
                                                        <a asp-controller="Enemy" asp-action="Delete" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                            Delete
                                                        </a>
                                                    }
                                                }
                                                else if (entity.Type == "TownNpc")
                                                {
                                                    <a asp-controller="TownNpc" asp-action="Details" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-info" title="Details">
                                                        Details
                                                    </a>
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <a asp-controller="TownNpc" asp-action="Edit" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-warning" title="Edit">
                                                            Edit
                                                        </a>
                                                        <a asp-controller="TownNpc" asp-action="Delete" asp-route-id="@entity.TypeId" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                            Delete
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
