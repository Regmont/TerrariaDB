﻿@{
    ViewData["Title"] = "Home Page";
}

<div class="terraria-container">
    <div class="header">
        <h1>TERRARIA <span>COMPENDIUM</span></h1>
    </div>

    <div class="hero-section">
        <div class="description-container">
            <p class="hero-text">Complete database of Terraria content. Explore bosses, enemies, items, and crafting recipes from the world of Terraria.</p>
        </div>
        <div class="recipe-card-wrapper">
            <a asp-controller="Recipes" asp-action="Index" class="terraria-card">
                <div class="card-icon"></div>
                <span class="card-title">Recipe System</span>
            </a>
        </div>
    </div>

    <div class="main-cards">
        <a asp-controller="Bosses" asp-action="Index" class="terraria-card">
            <div class="card-icon"></div>
            <span class="card-title">Bosses</span>
        </a>
        <a asp-controller="Enemies" asp-action="Index" class="terraria-card">
            <div class="card-icon"></div>
            <span class="card-title">Enemies</span>
        </a>
        <a asp-controller="TownNpcs" asp-action="Index" class="terraria-card">
            <div class="card-icon"></div>
            <span class="card-title">NPCs</span>
        </a>
        <a asp-controller="Items" asp-action="Index" class="terraria-card">
            <div class="card-icon"></div>
            <span class="card-title">Items</span>
        </a>
    </div>
</div>
