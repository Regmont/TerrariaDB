@model TerrariaDB.ViewModels.Terraria.Item.ItemIndexViewModel

@{
    ViewData["Title"] = "Items";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Items</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Create" class="table-btn table-btn-sm table-btn-success">
                            Create New
                        </a>
                    }
                </div>
            </div>
            <div class="table-page-body">
                @if (!Model.Items.Any())
                {
                    <div class="terraria-alert terraria-alert-info">
                        No items found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table-page">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="table-cell">
                                                <img src="@item.Sprite" alt="@item.Name" class="table-icon" />
                                                <span class="table-title">@item.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="table-actions">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="table-btn table-btn-sm table-btn-info" title="Details">
                                                    Details
                                                </a>
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    @* <a asp-action="Edit" asp-route-id="@item.Id" class="table-btn table-btn-sm table-btn-warning" title="Edit">
                                                        Edit
                                                    </a> *@
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="table-btn table-btn-sm table-btn-danger" title="Delete">
                                                        Delete
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
