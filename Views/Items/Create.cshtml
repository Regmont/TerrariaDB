@model TerrariaDB.ViewModels.Terraria.Item.ItemCreateViewModel

@{
    ViewData["Title"] = "Create Item";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Create New Item
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" type="text" class="form-control" placeholder="Enter item name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <input asp-for="Description" type="text" class="form-control" placeholder="Enter description" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="BasePrice" class="form-label fw-bold"></label>
                                <input asp-for="BasePrice" type="number" class="form-control" min="0" max="500000000" value="0" />
                                <span asp-validation-for="BasePrice" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="CurrencyName" class="form-label fw-bold">Currency Type</label>
                                <select asp-for="CurrencyName" asp-items="Model.AvailableCurrencies" class="form-select">
                                    <option value="">-- Select currency --</option>
                                </select>
                                <span asp-validation-for="CurrencyName" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="CraftingStationName" class="form-label fw-bold">Crafting station</label>
                                <select asp-for="CraftingStationName" asp-items="Model.AvailableCraftingStations" class="form-select">
                                    <option value="">-- None --</option>
                                </select>
                            </div>
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Stages</h5>
                                <span asp-validation-for="StageItemIds" class="text-danger d-block mb-3"></span>
                                <div class="row g-3">
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <div class="col-md-3">
                                            <label class="form-label small">Stage @(i + 1)</label>
                                            <select asp-for="StageItemIds[i]" asp-items="Model.AvailableItems" class="form-select">
                                                <option value="">-- Select item --</option>
                                            </select>
                                            <span asp-validation-for="StageItemIds[i]" class="text-danger small"></span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save Item
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
