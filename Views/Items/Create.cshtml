@model TerrariaDB.ViewModels.Terraria.Item.ItemCreateViewModel

@{
    ViewData["Title"] = "Create Item";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Create New Item</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <div class="grid-3 mb-20">
                        <div class="form-group">
                            <div class="label-text">Item Name</div>
                            <input asp-for="Name" type="text" placeholder="Enter item name" />
                            <span asp-validation-for="Name" class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <div class="label-text">Description</div>
                            <input asp-for="Description" type="text" placeholder="Enter description (optional)" data-val="false" />
                            <span asp-validation-for="Description" class="validation-message"></span>
                        </div>
                    </div>

                    <div class="grid-3 mb-20">
                        <div class="form-group">
                            <div class="label-text">Base Price</div>
                            <input asp-for="BasePrice" type="number" min="0" max="500000000" value="0" />
                            <span asp-validation-for="BasePrice" class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <div class="label-text">Currency Type</div>
                            <select asp-for="CurrencyName" asp-items="Model.AvailableCurrencies">
                                <option value="">-- Select currency --</option>
                            </select>
                            <span asp-validation-for="CurrencyName" class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <div class="label-text">Crafting Station</div>
                            <select asp-for="CraftingStationName" asp-items="Model.AvailableCraftingStations">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-card">
                        <h5>Stages</h5>
                        <span asp-validation-for="Stages" class="validation-message d-block mb-3"></span>
                        <div class="grid-4">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="terraria-card" style="padding: 15px; align-items: flex-start; cursor: default;" >
                                    <div class="form-group">
                                        <div class="label-text">Stage @(i + 1) Sprite</div>
                                        @if (i == 0)
                                        {
                                            <input asp-for="Stages[i].Sprite" type="text" placeholder="Enter sprite path" />
                                            <span asp-validation-for="Stages[i].Sprite" class="validation-message"></span>
                                        }
                                        else
                                        {
                                            <input asp-for="Stages[i].Sprite" type="text" placeholder="Enter sprite path" data-val="false" />
                                        }
                                    </div>

                                    <div class="form-group" style="margin-top: 10px;">
                                        <div class="label-text">Item ID</div>
                                        @if (i == 0)
                                        {
                                            <input asp-for="FirstItemId" type="number" min="0" max="10000" />
                                            <span asp-validation-for="FirstItemId" class="validation-message"></span>
                                        }
                                        else if (i == 1)
                                        {
                                            <input asp-for="SecondItemId" type="number" min="0" max="10000" />
                                        }
                                        else if (i == 2)
                                        {
                                            <input asp-for="ThirdItemId" type="number" min="0" max="10000" />
                                        }
                                        else if (i == 3)
                                        {
                                            <input asp-for="FourthItemId" type="number" min="0" max="10000" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn table-btn-success">Save Item</button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    input, input:focus, input:active, input:hover,
    select, select:focus, select:active, select:hover {
        background-color: #1a1f2e !important;
        border: 2px solid #8b6b4d !important;
        color: #ffd700 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 16px !important;
        width: 100% !important;
        box-sizing: border-box !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5) !important;
        outline: none !important;
    }

        select option {
            background-color: #1a1f2e !important;
            color: #ffd700 !important;
        }

        input:focus, select:focus {
            border-color: #c0a88c !important;
            background-color: #141229 !important;
        }

            input:focus:not(:placeholder-shown),
            select:focus:not(:placeholder-shown) {
                background-color: #0f1420 !important;
                border-color: #ffd700 !important;
            }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active,
        select:-webkit-autofill,
        select:-webkit-autofill:hover,
        select:-webkit-autofill:focus,
        select:-webkit-autofill:active {
            background-color: #0f1420 !important;
            border-color: #ffd700 !important;
            -webkit-text-fill-color: #ffd700 !important;
            -webkit-box-shadow: 0 0 0px 1000px #0f1420 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    .terraria-card {
        background: linear-gradient(145deg, #3a2c20 0%, #2a1e14 100%);
        border: 4px solid #8b6b4d;
        box-shadow: 0 8px 0 #4a3c2c;
        padding: 15px;
    }

        .terraria-card:hover {
            transform: none !important;
            box-shadow: 0 8px 0 #4a3c2c !important;
            border-color: #8b6b4d !important;
            background: linear-gradient(145deg, #3a2c20 0%, #2a1e14 100%) !important;
        }

    .d-block {
        display: block;
    }

    .mb-3 {
        margin-bottom: 15px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
