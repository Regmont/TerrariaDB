@model TerrariaDB.ViewModels.Terraria.Item.ItemDetailsViewModel

@{
    ViewData["Title"] = "Item Details";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>
                    <i class="bi bi-box"></i> @Model.Name
                </h4>
                <div class="horizontal-container">
                    <a asp-action="Index" class="table-btn table-btn-sm">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    <a asp-controller="Recipes" asp-action="Index" asp-route-resultItem="@Model.Name"
                       class="table-btn table-btn-sm table-btn-success">
                        <i class="bi bi-book"></i> Recipes
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        @* <a asp-action="Edit" asp-route-id="@Model.ItemId" class="table-btn table-btn-sm table-btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a> *@
                        <a asp-action="Delete" asp-route-id="@Model.ItemId" class="table-btn table-btn-sm table-btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                </div>
            </div>
            <div class="table-page-body">
                <div class="grid-2" style="margin-bottom: 20px;">
                    <div class="form-group" style="display: flex; align-items: center; gap: 20px;">
                        <div class="card-icon" style="width: 150px; height: 150px;">
                            <img src="@Model.Sprite" alt="@Model.Name" class="@(string.IsNullOrEmpty(Model.Sprite) ? "small-img" : "")" />
                        </div>
                        <div style="flex: 1;">
                            <div class="label-text" style="font-size: 16px; margin-bottom: 15px;">@Model.Description</div>
                            <div class="grid-2" style="gap: 10px;">
                                <div class="terraria-card" style="padding: 10px; cursor: default;">
                                    <div class="table-subtitle">Item ID</div>
                                    <div class="table-title" style="font-size: 14px;">@Model.ItemId</div>
                                    <div class="table-subtitle" style="margin-top: 5px;">Base price</div>
                                    <div class="table-title" style="font-size: 18px;">@Model.BasePrice <span class="table-subtitle">@Model.CurrencyType</span></div>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.CraftingStationName))
                                {
                                    <div class="terraria-card" style="padding: 10px; cursor: default;">
                                        <div class="table-subtitle">Crafting station</div>
                                        <div class="table-title" style="font-size: 18px;">@Model.CraftingStationName</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.SummonedBossName))
                {
                    <div class="form-section">
                        <div class="form-section-title">Summoned Boss</div>
                        <div class="terraria-card" style="padding: 15px; cursor: default; display: flex; flex-direction: row; align-items: center; gap: 15px;">
                            <div class="card-icon" style="width: 48px; height: 48px;">
                                <img src="@Model.SummonedBossSprite" alt="@Model.SummonedBossName" />
                            </div>
                            <div class="card-title" style="font-size: 18px; margin: 0;">@Model.SummonedBossName</div>
                        </div>
                    </div>
                }

                @if (Model.Transformations.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Stages</div>
                        <div class="horizontal-container" style="overflow-x: auto; padding-bottom: 10px; gap: 15px;">
                            @foreach (var transformation in Model.Transformations)
                            {
                                <div class="terraria-card" style="min-width: 100px; padding: 10px; cursor: default;">
                                    <div class="card-icon" style="width: 60px; height: 60px;">
                                        <img src="@transformation.Sprite" alt="@transformation.Name" class="@(string.IsNullOrEmpty(transformation.Sprite) ? "small-img" : "")" />
                                    </div>
                                    <div class="card-title" style="font-size: 10px; margin-top: 10px;">@transformation.Name</div>
                                    <div class="table-subtitle" style="font-size: 8px; margin-top: 2px;">ID: @transformation.ItemId</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.DroppedFromBosses.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Dropped From Bosses</div>
                        <div class="horizontal-container" style="gap: 10px; flex-wrap: wrap;">
                            @foreach (var boss in Model.DroppedFromBosses)
                            {
                                <div class="terraria-card" style="padding: 10px; cursor: default; display: flex; flex-direction: row; align-items: center; gap: 10px;">
                                    <div class="card-icon" style="width: 32px; height: 32px;">
                                        <img src="@boss.Sprite" alt="@boss.Name" />
                                    </div>
                                    <span class="card-title" style="font-size: 12px; margin: 0;">@boss.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.DroppedFromEntities.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Dropped From Entities</div>
                        <div class="grid-8">
                            @foreach (var entity in Model.DroppedFromEntities)
                            {
                                <div class="terraria-card" style="padding: 8px; cursor: default;">
                                    <div class="card-icon" style="width: 40px; height: 40px;">
                                        <img src="@entity.Sprite" alt="@entity.Name" class="@(string.IsNullOrEmpty(entity.Sprite) ? "small-img" : "")" />
                                    </div>
                                    <div class="card-title" style="font-size: 8px; margin-top: 5px;">@entity.Name</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Model.TradedByNpcs.Any())
                {
                    <div class="form-section">
                        <div class="form-section-title">Traded By NPCs</div>
                        <div class="grid-3">
                            @foreach (var trade in Model.TradedByNpcs)
                            {
                                <div class="terraria-card" style="padding: 15px; cursor: default;">
                                    <div class="horizontal-container" style="margin-bottom: 15px;">
                                        <div class="card-icon" style="width: 40px; height: 40px;">
                                            <img src="@trade.Sprite" alt="@trade.Name" class="@(string.IsNullOrEmpty(trade.Sprite) ? "small-img" : "")" />
                                        </div>
                                        <div class="card-title" style="font-size: 14px; margin: 0;">@trade.Name</div>
                                    </div>
                                    <div style="border-top: 2px solid #8b6b4d; padding-top: 10px;">
                                        <div class="horizontal-container" style="justify-content: space-between;">
                                            <span class="table-subtitle">Quantity:</span>
                                            <span class="table-title" style="font-size: 14px;">@trade.Quantity</span>
                                        </div>
                                        <div class="horizontal-container" style="justify-content: space-between;">
                                            <span class="table-subtitle">Total:</span>
                                            <span class="table-title" style="font-size: 14px;">@trade.TotalPrice</span>
                                        </div>
                                        <div class="horizontal-container" style="justify-content: space-between; margin-top: 5px;">
                                            <span class="table-subtitle">Type:</span>
                                            <span class="entity-badge" style="background: #2a1e14; color: #ffd700;">@trade.TradeType</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .bi {
        margin-right: 5px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .grid-8 {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 10px;
    }

    .card-icon {
        background: #2a1e14;
        border: 3px solid #6b4f35;
        padding: 2px;
        box-shadow: inset 0 0 0 2px #1a140e;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .card-icon img {
            max-height: 100%;
            max-width: 100%;
        }

    .small-img {
        height: 50% !important;
    }

    .terraria-card {
        cursor: default;
        position: relative;
    }

        .terraria-card:hover {
            transform: none !important;
            box-shadow: 0 8px 0 #4a3c2c !important;
            border-color: #8b6b4d !important;
            background: linear-gradient(145deg, #3a2c20 0%, #2a1e14 100%) !important;
        }

    .card-title {
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #ffd700;
        text-shadow: 2px 2px 0 #8b4513;
        text-align: center;
        word-break: break-word;
    }

    .table-subtitle {
        color: #c0a88c;
        font-size: 12px;
        text-transform: uppercase;
    }

    .table-title {
        font-weight: bold;
        color: #ffd700;
        text-shadow: 2px 2px 0 #8b4513;
        letter-spacing: 1px;
    }

    .entity-badge {
        padding: 3px 8px;
        box-shadow: 0 2px 0 #4a3c2c;
        display: inline-block;
        background: #2a1e14;
        border: 2px solid #8b6b4d;
        font-size: 12px;
    }

    .horizontal-container {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .form-section {
        margin-bottom: 30px;
    }

        .form-section:last-child {
            margin-bottom: 0;
        }

    .form-section-title {
        color: #ffd700;
        font-family: 'Courier New', monospace;
        font-size: 20px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-shadow: 2px 2px 0 #8b4513;
    }

    @@media (max-width: 768px) {
        .grid-2 {
            grid-template-columns: 1fr;
        }

        .grid-3 {
            grid-template-columns: repeat(2, 1fr);
        }

        .grid-8 {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .grid-3 {
            grid-template-columns: 1fr;
        }

        .grid-8 {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
