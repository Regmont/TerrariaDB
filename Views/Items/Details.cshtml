@model TerrariaDB.ViewModels.Terraria.Item.ItemDetailsViewModel

@{
    ViewData["Title"] = "Item Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-box"></i> @Model.Name
            </h4>
            <div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-resultItem="@Model.Name"
                   class="btn btn-success btn-sm me-2">
                    <i class="bi bi-book"></i> Recipes
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.ItemId" class="btn btn-warning btn-sm me-2">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.ItemId" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-3 text-center">
                    <img src="@Model.Sprite" alt="@Model.Name" class="img-fluid border rounded bg-light p-2" style="max-height: 150px;" />
                </div>
                <div class="col-md-9">
                    <h5 class="text-muted mb-3">@Model.Description</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <strong>Base price:</strong>
                                    <div class="fs-5">@Model.BasePrice <small class="text-muted">@Model.CurrencyType</small></div>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CraftingStationName))
                        {
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <strong>Crafting station:</strong>
                                        <div class="fs-5">@Model.CraftingStationName</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.SummonedBossName))
            {
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">Summoned Boss</h5>
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded">
                        <img src="@Model.SummonedBossSprite" alt="@Model.SummonedBossName" style="width: 48px; height: 48px; object-fit: contain;" />
                        <span class="fw-bold">@Model.SummonedBossName</span>
                    </div>
                </div>
            }

            @if (Model.Transformations.Any())
            {
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">Stages</h5>
                    <div class="row flex-nowrap overflow-auto pb-2" style="gap: 1rem;">
                        @foreach (var transformation in Model.Transformations.Take(4))
                        {
                            <div class="col-auto">
                                <div class="card text-center" style="width: 100px;">
                                    <img src="@transformation.Sprite" class="card-img-top p-2" alt="@transformation.Name" style="height: 60px; object-fit: contain;" />
                                    <div class="card-body p-1">
                                        <small class="card-text text-truncate d-block">@transformation.Name</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.DroppedFromBosses.Any())
            {
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">Dropped From Bosses</h5>
                    <div class="row g-2">
                        @foreach (var boss in Model.DroppedFromBosses.Take(3))
                        {
                            <div class="col-auto">
                                <div class="d-flex align-items-center gap-2 p-2 border rounded">
                                    <img src="@boss.Sprite" alt="@boss.Name" style="width: 32px; height: 32px; object-fit: contain;" />
                                    <span>@boss.Name</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.DroppedFromEntities.Any())
            {
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">Dropped From Entities</h5>
                    <div class="row flex-nowrap overflow-auto pb-2" style="gap: 0.5rem;">
                        @foreach (var entity in Model.DroppedFromEntities.Take(15))
                        {
                            <div class="col-auto">
                                <div class="card text-center" style="width: 80px;">
                                    <img src="@entity.Sprite" class="card-img-top p-1" alt="@entity.Name" style="height: 40px; object-fit: contain;" />
                                    <div class="card-body p-1">
                                        <small class="card-text text-truncate d-block">@entity.Name</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.TradedByNpcs.Any())
            {
                <div class="mb-4">
                    <h5 class="border-bottom pb-2">Traded By NPCs</h5>
                    <div class="row flex-nowrap overflow-auto pb-2" style="gap: 1rem;">
                        @foreach (var trade in Model.TradedByNpcs.Take(3))
                        {
                            <div class="col-auto" style="min-width: 200px;">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-3 mb-2">
                                            <img src="@trade.Sprite" alt="@trade.Name" style="width: 40px; height: 40px; object-fit: contain;" />
                                            <strong>@trade.Name</strong>
                                        </div>
                                        <div class="small">
                                            <div class="d-flex justify-content-between">
                                                <span>Quantity:</span>
                                                <span class="fw-bold">@trade.Quantity</span>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span>Total:</span>
                                                <span class="fw-bold">@trade.TotalPrice</span>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span>Type:</span>
                                                <span class="badge bg-info">@trade.TradeType</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
