@model TerrariaDB.ViewModels.Terraria.Item.ItemDeleteViewModel

@{
    ViewData["Title"] = "Delete Item";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Delete Item</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <div class="terraria-alert" style="border-color: #8b3a3a; background: #3a1e1e; color: #ff6b6b; margin-bottom: 20px;">
                    <i class="bi bi-exclamation-triangle"></i>
                    Are you sure you want to delete this item?
                </div>

                <div class="terraria-card" style="padding: 20px; margin-bottom: 20px; align-items: center; cursor: default; pointer-events: none;">
                    <div class="card-icon">
                        <img src="@Model.Sprite" alt="@Model.Name" class="@(string.IsNullOrEmpty(Model.Sprite) ? "small-img" : "")" />
                    </div>
                    <div class="card-title" style="font-size: 24px; margin-top: 15px;">@Model.Name</div>
                </div>

                @if (Model.HasRelatedRecipes)
                {
                    <div class="terraria-alert" style="border-color: #b8860b; background: #3a2c1e; color: #ffd700; margin-bottom: 20px;">
                        <i class="bi bi-exclamation-circle"></i>
                        <strong>Warning:</strong> All related recipes will be deleted!
                    </div>
                }

                @if (Model.IsLastCraftingStationItem)
                {
                    <div class="terraria-alert" style="border-color: #8b3a3a; background: #3a1e1e; color: #ff6b6b; margin-bottom: 20px;">
                        <i class="bi bi-x-circle"></i>
                        <strong>Cannot delete:</strong> This item is the last item related to a crafting station!
                    </div>
                }

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ItemId" />
                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn @(Model.IsLastCraftingStationItem ? "table-btn-danger" : "table-btn-success")" @(Model.IsLastCraftingStationItem ? "disabled" : "")>
                            Confirm Delete
                        </button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    button:disabled, .table-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    .bi {
        margin-right: 5px;
    }

    .terraria-alert strong {
        color: #ffd700;
    }
</style>
