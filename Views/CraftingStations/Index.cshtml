@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationIndexViewModel

@{
    ViewData["Title"] = "Crafting Stations";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-grid"></i> Crafting Stations
            </h4>
            <div>
                <a asp-action="Index" asp-controller="Home" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-house"></i> Home
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle"></i> Create New
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!Model.CraftingStations.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    No crafting stations found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Station</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var station in Model.CraftingStations)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@station.Sprite" alt="@station.Name" style="width: 40px; height: 40px; object-fit: contain;" />
                                            <span class="fw-bold">@station.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@station.Name" class="btn btn-info text-white">
                                                <i class="bi bi-eye"></i> Details
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@station.Name" class="btn btn-warning">
                                                    <i class="bi bi-pencil"></i> Edit
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@station.Name" class="btn btn-danger">
                                                    <i class="bi bi-trash"></i> Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
