@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationDetailsViewModel

@{
    ViewData["Title"] = "Crafting Station Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-hammer"></i> @Model.CraftingStationName
            </h4>
            <div>
                <a asp-action="Index" class="btn btn-outline-light btn-sm me-2">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.CraftingStationName" class="btn btn-warning btn-sm me-2">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.CraftingStationName" class="btn btn-danger btn-sm me-2">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }
                <a asp-controller="Recipes"
                   asp-action="Index"
                   asp-route-craftingStation="@Model.CraftingStationName"
                   class="btn btn-success btn-sm">
                    <i class="bi bi-list"></i> Recipes
                </a>
            </div>
        </div>
        <div class="card-body">
            <h5 class="card-title mb-3">Represented By Items</h5>
            
            @if (!Model.Items.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    No items represent this crafting station.
                </div>
            }
            else
            {
                <div class="row flex-nowrap overflow-auto pb-2" style="gap: 1rem;">
                    @foreach (var item in Model.Items)
                    {
                        <div class="col-auto">
                            <div class="card text-center" style="width: 120px;">
                                <img src="@item.Sprite" class="card-img-top p-2" alt="@item.Name" style="height: 80px; object-fit: contain;" />
                                <div class="card-body p-2">
                                    <small class="card-text text-truncate d-block">@item.Name</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
