@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationDetailsViewModel

@{
    ViewData["Title"] = "Crafting Station Details";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>
                    <i class="bi bi-hammer"></i> @Model.CraftingStationName
                </h4>
                <div class="horizontal-container">
                    <a asp-action="Index" class="table-btn table-btn-sm">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        @* <a asp-action="Edit" asp-route-id="@Model.CraftingStationName" class="table-btn table-btn-sm table-btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a> *@
                        <a asp-action="Delete" asp-route-id="@Model.CraftingStationName" class="table-btn table-btn-sm table-btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                    <a asp-controller="Recipes"
                       asp-action="Index"
                       asp-route-craftingStation="@Model.CraftingStationName"
                       class="table-btn table-btn-sm table-btn-success">
                        <i class="bi bi-list"></i> Recipes
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <div class="form-section">
                    <div class="form-section-title">Represented By Items</div>

                    @if (!Model.Items.Any())
                    {
                        <div class="terraria-alert terraria-alert-info">
                            <i class="bi bi-info-circle"></i>
                            No items represent this crafting station.
                        </div>
                    }
                    else
                    {
                        <div class="grid-6">
                            @foreach (var item in Model.Items)
                            {
                                <div class="terraria-card" style="padding: 15px; cursor: default;">
                                    <div class="card-icon" style="width: 80px; height: 80px;">
                                        <img src="@item.Sprite" alt="@item.Name" class="@(string.IsNullOrEmpty(item.Sprite) ? "small-img" : "")" />
                                    </div>
                                    <div class="card-title" style="font-size: 12px; margin-top: 10px;">@item.Name</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bi {
        margin-right: 5px;
    }

    .grid-6 {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 15px;
    }

    .terraria-card {
        cursor: default;
        pointer-events: none;
    }

        .terraria-card:hover {
            transform: none !important;
            box-shadow: 0 8px 0 #4a3c2c !important;
            border-color: #8b6b4d !important;
            background: linear-gradient(145deg, #3a2c20 0%, #2a1e14 100%) !important;
        }

    .card-icon {
        width: 80px;
        height: 80px;
        background: #2a1e14;
        border: 3px solid #6b4f35;
        padding: 2px;
        box-shadow: inset 0 0 0 2px #1a140e;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .card-icon img {
            max-height: 100%;
            max-width: 100%;
        }

    .small-img {
        height: 50% !important;
    }

    .card-title {
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #ffd700;
        text-shadow: 2px 2px 0 #8b4513;
        text-align: center;
        font-size: 12px;
        margin-top: 10px;
    }

    @@media (max-width: 768px) {
        .grid-6 {
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }
    }

    @@media (max-width: 480px) {
        .grid-6 {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
