@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationCreateViewModel

<h1>Create Crafting Station</h1>

<a asp-action="Index">Back</a>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <div>
            <label asp-for="CraftingStationName"></label>
            <input asp-for="CraftingStationName" />
            <span asp-validation-for="CraftingStationName"></span>
        </div>
    </div>

    <div>
        <label asp-for="SelectedItemId">Represented by</label>
        <select asp-for="SelectedItemId" asp-items="Model.AvailableItems"></select>
        <span asp-validation-for="SelectedItemId"></span>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
