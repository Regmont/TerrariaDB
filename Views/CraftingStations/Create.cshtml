@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationCreateViewModel

@{
    ViewData["Title"] = "Create Crafting Station";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-hammer"></i> Create Crafting Station
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CraftingStationName" class="form-label fw-bold"></label>
                            <input asp-for="CraftingStationName" class="form-control" placeholder="Enter station name" />
                            <span asp-validation-for="CraftingStationName" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SelectedItemId" class="form-label fw-bold">Represented by</label>
                            <select asp-for="SelectedItemId" asp-items="Model.AvailableItems" class="form-select">
                                <option value="">-- Select an item --</option>
                            </select>
                            <span asp-validation-for="SelectedItemId" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Save
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
