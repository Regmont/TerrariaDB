@model TerrariaDB.ViewModels.Terraria.CraftingStation.CraftingStationDeleteViewModel

@{
    ViewData["Title"] = "Delete Crafting Station";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Delete Crafting Station
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Are you sure you want to delete this crafting station?
                    </div>

                    <div class="text-center mb-4">
                        <div class="d-inline-block p-3 border rounded bg-light">
                            <img src="@Model.Sprite" alt="@Model.CraftingStationName" class="img-fluid" style="max-width: 100px;" />
                            <div class="mt-2">
                                <strong>@Model.CraftingStationName</strong>
                            </div>
                        </div>
                    </div>

                    @if (Model.HasRelatedRecipes)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-circle"></i>
                            <strong>Warning:</strong> All related recipes will be deleted!
                        </div>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="CraftingStationName" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
