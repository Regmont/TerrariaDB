@model TerrariaDB.ViewModels.Terraria.TownNpc.TownNpcEditViewModel

@{
    ViewData["Title"] = "Edit Town NPC";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil"></i> Edit Town NPC
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input type="hidden" asp-for="TownNpcId" />

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold"></label>
                                <input asp-for="Name" type="text" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Description" class="form-label fw-bold"></label>
                                <input asp-for="Description" type="text" class="form-control" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <h5 class="mb-3">Stages</h5>
                        <div class="row g-4 mb-4">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="col-md-3">
                                    <div class="card border-warning h-100">
                                        <div class="card-header bg-warning bg-opacity-10">
                                            <h6 class="mb-0">Stage @(i + 1)</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <label asp-for="Stages[i].Sprite" class="form-label small fw-bold">Sprite URL</label>
                                                <input asp-for="Stages[i].Sprite" type="text" class="form-control form-control-sm" />
                                                <span asp-validation-for="Stages[i].Sprite" class="text-danger small"></span>
                                            </div>
                                            <div class="row mb-2">
                                                <div class="col-6">
                                                    <label class="small fw-bold">HP</label>
                                                    <input type="text" class="form-control form-control-sm bg-light" value="@Model.Stages[0].Hp" readonly />
                                                </div>
                                                <div class="col-6">
                                                    <label class="small fw-bold">Defense</label>
                                                    <input type="text" class="form-control form-control-sm bg-light" value="@Model.Stages[0].Defense" readonly />
                                                </div>
                                            </div>
                                            <div class="mb-2">
                                                <label asp-for="Stages[i].EntityId" class="form-label small fw-bold">Game ID</label>
                                                <input asp-for="Stages[i].EntityId" type="number" class="form-control form-control-sm" />
                                                <span asp-validation-for="Stages[i].EntityId" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Drops</h5>
                                <div class="row g-2">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <div class="col-md-2 town-drop" data-index="@i">
                                            <div class="border rounded p-2 bg-white">
                                                <select asp-for="Drops[i].ItemId" asp-items="Model.AvailableItems" class="form-select form-select-sm mb-2">
                                                    <option value="">-- Item --</option>
                                                </select>
                                                <div class="input-group input-group-sm">
                                                    <input asp-for="Drops[i].Quantity" type="number" class="form-control" min="1" max="100" />
                                                    <button type="button" class="btn btn-outline-secondary clear-town-drop" data-index="@i">
                                                        <i class="bi bi-eraser"></i>
                                                    </button>
                                                </div>
                                                <span asp-validation-for="Drops[i].Quantity" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-3">Trades</h5>
                                <div class="row g-3">
                                    @for (int i = 0; i < 15; i++)
                                    {
                                        <div class="col-md-4 col-lg-3 town-trade" data-index="@i">
                                            <div class="border rounded p-2 bg-white">
                                                <select asp-for="Trades[i].ItemId" asp-items="Model.AvailableItems" class="form-select form-select-sm mb-2">
                                                    <option value="">-- Item --</option>
                                                </select>
                                                <div class="row g-1 mb-2">
                                                    <div class="col-6">
                                                        <input asp-for="Trades[i].Quantity" type="number" class="form-control form-control-sm" min="1" max="50" placeholder="Qty" />
                                                    </div>
                                                    <div class="col-6">
                                                        <select asp-for="Trades[i].TradeType" asp-items="Model.AvailableTradeTypes" class="form-select form-select-sm">
                                                            <option value="">Type</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-outline-secondary w-100 clear-town-trade" data-index="@i">
                                                    <i class="bi bi-eraser"></i> Clear
                                                </button>
                                                <span asp-validation-for="Trades[i].Quantity" class="text-danger small"></span>
                                                <span asp-validation-for="Trades[i].TradeType" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-town-drop').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const dropDiv = this.closest('.town-drop');

                const select = dropDiv.querySelector('select');
                const input = dropDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = 1;
            });
        });

        document.querySelectorAll('.clear-town-trade').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const tradeDiv = this.closest('.town-trade');

                const selects = tradeDiv.querySelectorAll('select');
                const input = tradeDiv.querySelector('input[type="number"]');

                selects.forEach(select => select.selectedIndex = 0);
                if (input) input.value = 1;
            });
        });
    </script>
}
