@model TerrariaDB.ViewModels.Terraria.TownNpc.TownNpcCreateViewModel

<h1>Create Town NPC</h1>

<a asp-action="Index">Back</a>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" type="text" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div>
            <label asp-for="Description"></label>
            <input asp-for="Description" type="text" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <div>
        <div style="display: flex; flex-direction: row;">
            <div class="town-stage" data-stage="0">
                <div>
                    <label asp-for="Stages[0].Sprite">Sprite</label>
                    <input asp-for="Stages[0].Sprite" type="text" />
                    <span asp-validation-for="Stages[0].Sprite" class="text-danger"></span>
                </div>
                <div>
                    <label>HP:</label>
                    @Model.Stages[0].Hp
                </div>
                <div>
                    <label>Defense:</label>
                    @Model.Stages[0].Defense
                </div>
                <div>
                    <label asp-for="Stages[0].EntityId">Game ID</label>
                    <input asp-for="Stages[0].EntityId" type="number" />
                    <span asp-validation-for="Stages[0].EntityId" class="text-danger"></span>
                </div>
            </div>
            @for (int i = 1; i < 4; i++)
            {
                <div class="town-stage" data-stage="@i">
                    <div>
                        <label asp-for="Stages[i].Sprite">Sprite</label>
                        <input asp-for="Stages[i].Sprite" type="text" />
                        <span asp-validation-for="Stages[i].Sprite" class="text-danger"></span>
                    </div>
                    <div>
                        <label>HP:</label>
                        @Model.Stages[i].Hp
                    </div>
                    <div>
                        <label>Defense:</label>
                        @Model.Stages[i].Defense
                    </div>
                    <div>
                        <label asp-for="Stages[i].EntityId">Game ID</label>
                        <input asp-for="Stages[i].EntityId" type="number" />
                        <span asp-validation-for="Stages[i].EntityId" class="text-danger"></span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div>
        <label>Drop</label>
        <div style="display: flex; flex-direction: row;">
            @for (int i = 0; i < 5; i++)
            {
                <div class="town-drop" data-index="@i">
                    <select asp-for="Drops[i].ItemId" asp-items="Model.AvailableItems"></select>
                    <input asp-for="Drops[i].Quantity" type="number" />
                    <span asp-validation-for="Drops[i].Quantity" class="text-danger"></span>
                    <button type="button" class="clear-town-drop" data-index="@i">Clear</button>
                </div>
            }
        </div>
    </div>

    <div>
        <label>Trades</label>
        <div style="display: flex; flex-direction: row;">
            @for (int i = 0; i < 15; i++)
            {
                <div class="town-trade" data-index="@i">
                    <select asp-for="Trades[i].ItemId" asp-items="Model.AvailableItems"></select>
                    <input asp-for="Trades[i].Quantity" type="number" />
                    <span asp-validation-for="Trades[i].Quantity" class="text-danger"></span>
                    <select asp-for="Trades[i].TradeType" asp-items="Model.AvailableTradeTypes"></select>
                    <span asp-validation-for="Trades[i].TradeType" class="text-danger"></span>
                    <button type="button" class="clear-town-trade" data-index="@i">Clear</button>
                </div>
            }
        </div>
    </div>

    <button type="submit">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-town-drop').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const dropDiv = document.querySelector(`.town-drop[data-index="${index}"]`);

                const select = dropDiv.querySelector('select');
                const input = dropDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = '1';
            });
        });

        document.querySelectorAll('.clear-town-trade').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const index = this.getAttribute('data-index');
                const tradeDiv = document.querySelector(`.town-trade[data-index="${index}"]`);

                const selects = tradeDiv.querySelectorAll('select');
                const input = tradeDiv.querySelector('input[type="number"]');

                selects.forEach(select => select.selectedIndex = 0);
                if (input) input.value = '1';
            });
        });
    </script>
}
