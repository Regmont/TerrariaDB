@model TerrariaDB.ViewModels.Terraria.TownNpc.TownNpcCreateViewModel

@{
    ViewData["Title"] = "Create Town NPC";
}

<div class="terraria-page">
    <div class="terraria-page-wide">
        <div class="table-page-card">
            <div class="table-page-header">
                <h4>Create New Town NPC</h4>
                <div class="horizontal-container">
                    <a asp-action="Index" asp-controller="Home" class="table-btn table-btn-sm">
                        Home
                    </a>
                </div>
            </div>
            <div class="table-page-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="terraria-alert terraria-alert-info" role="alert"></div>

                    <div class="grid-2 mb-20">
                        <div class="form-group">
                            <div class="label-text">NPC Name</div>
                            <input asp-for="Name" type="text" placeholder="Enter NPC name" />
                            <span asp-validation-for="Name" class="validation-message"></span>
                        </div>
                        <div class="form-group">
                            <div class="label-text">Description</div>
                            <input asp-for="Description" type="text" placeholder="Enter description" />
                            <span asp-validation-for="Description" class="validation-message"></span>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">Stages</div>
                        <div class="grid-4">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="item-card">
                                    <div class="item-card-header">@(i == 0 ? "Base Stage" : $"Stage {i + 1}")</div>

                                    <div class="form-group">
                                        <div class="label-text">Sprite URL</div>
                                        @if (i == 0)
                                        {
                                            <input asp-for="Stages[i].Sprite" type="text" />
                                            <span asp-validation-for="Stages[i].Sprite" class="validation-message"></span>
                                        }
                                        else
                                        {
                                            <input asp-for="Stages[i].Sprite" type="text" data-val="false" />
                                        }
                                    </div>

                                    <div class="grid-2" style="gap: 5px;">
                                        <div class="form-group">
                                            <div class="label-text">HP</div>
                                            <input type="text" class="readonly-input" value="@Model.Stages[i].Hp" readonly />
                                            <input type="hidden" asp-for="Stages[i].Hp" />
                                        </div>
                                        <div class="form-group">
                                            <div class="label-text">Defense</div>
                                            <input type="text" class="readonly-input" value="@Model.Stages[i].Defense" readonly />
                                            <input type="hidden" asp-for="Stages[i].Defense" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="label-text">Game ID</div>
                                        <input asp-for="Stages[i].EntityId" type="number")" />
                                        <span asp-validation-for="Stages[i].EntityId" class="validation-message"></span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-card">
                        <h5>Drops</h5>
                        <div class="grid-5">
                            @for (int i = 0; i < 5; i++)
                            {
                                <div class="form-group town-drop" data-index="@i">
                                    <select asp-for="Drops[i].ItemId" asp-items="Model.AvailableItems" data-val="false">
                                        <option value="">-- Item --</option>
                                    </select>
                                    <div class="horizontal-container" style="margin-top: 5px;">
                                        <input asp-for="Drops[i].Quantity" type="number" min="1" max="100" value="1" />
                                        <span asp-validation-for="Drops[i].Quantity" class="validation-message"></span>
                                        <button type="button" class="table-btn table-btn-sm clear-town-drop" data-index="@i">Clear</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-card">
                        <h5>Trades</h5>
                        <div class="grid-5">
                            @for (int i = 0; i < 15; i++)
                            {
                                <div class="item-card town-trade" data-index="@i" style="padding: 8px;">
                                    <div class="form-group" style="margin-bottom: 5px;">
                                        <select asp-for="Trades[i].ItemId" asp-items="Model.AvailableItems" data-val="false">
                                            <option value="">-- Item --</option>
                                        </select>
                                    </div>
                                    <div class="grid-2" style="gap: 5px; margin-bottom: 5px;">
                                        <input asp-for="Trades[i].Quantity" type="number" min="1" max="50" value="1" placeholder="Qty" data-val="false" />
                                        <span asp-validation-for="Trades[i].Quantity" class="validation-message"></span>
                                        <select asp-for="Trades[i].TradeType" asp-items="Model.AvailableTradeTypes" data-val="false">
                                            <option value="">Type</option>
                                        </select>
                                    </div>
                                    <button type="button" class="table-btn table-btn-sm w-100 clear-town-trade" data-index="@i">Clear</button>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="horizontal-container mt-20">
                        <button type="submit" class="table-btn table-btn-success">Save Town NPC</button>
                        <a asp-action="Index" class="table-btn">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    input, input:focus, input:active, input:hover,
    select, select:focus, select:active, select:hover {
        background-color: #1a1f2e !important;
        border: 2px solid #8b6b4d !important;
        color: #ffd700 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 16px !important;
        width: 100% !important;
        box-sizing: border-box !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5) !important;
        outline: none !important;
    }

    .readonly-input, .readonly-input:focus, .readonly-input:active, .readonly-input:hover {
        background-color: #2a1e14 !important;
        border: 2px solid #6b4f35 !important;
        color: #c0a88c !important;
        cursor: not-allowed !important;
    }

    select option {
        background-color: #1a1f2e !important;
        color: #ffd700 !important;
    }

    input:focus, select:focus {
        border-color: #c0a88c !important;
        background-color: #141229 !important;
    }

        input:focus:not(:placeholder-shown),
        select:focus:not(:placeholder-shown) {
            background-color: #0f1420 !important;
            border-color: #ffd700 !important;
        }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus,
    input:-webkit-autofill:active,
    select:-webkit-autofill,
    select:-webkit-autofill:hover,
    select:-webkit-autofill:focus,
    select:-webkit-autofill:active {
        background-color: #0f1420 !important;
        border-color: #ffd700 !important;
        -webkit-text-fill-color: #ffd700 !important;
        -webkit-box-shadow: 0 0 0px 1000px #0f1420 inset !important;
        transition: background-color 5000s ease-in-out 0s;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('.clear-town-drop').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const dropDiv = this.closest('.town-drop');
                const select = dropDiv.querySelector('select');
                const input = dropDiv.querySelector('input[type="number"]');

                if (select) select.selectedIndex = 0;
                if (input) input.value = 1;
            });
        });

        document.querySelectorAll('.clear-town-trade').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const tradeDiv = this.closest('.town-trade');
                const selects = tradeDiv.querySelectorAll('select');
                const input = tradeDiv.querySelector('input[type="number"]');

                selects.forEach(select => select.selectedIndex = 0);
                if (input) input.value = 1;
            });
        });
    </script>
}
