<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TerrariaDB</title>
    <link rel="stylesheet" href="~/TerrariaDB.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="terraria-header">
        <a asp-controller="Home" asp-action="Index" class="terraria-logo">Terraria</a>
        <div class="auth-container">
            <partial name="_LoginPartial" />
        </div>
    </header>

    <div class="body-horizontal">
        <main class="main-content">
            @RenderBody()
        </main>
        <aside class="registries-sidebar">
            <h2 class="sidebar-title">Registries</h2>
            <div class="vertical-scrollbar-container">
                <a asp-controller="CraftingStations" asp-action="Index" class="terraria-card">
                    <div class="card-icon"></div>
                    <span class="card-title">Crafting Stations</span>
                </a>
                <a asp-controller="Entities" asp-action="Index" class="terraria-card">
                    <div class="card-icon"></div>
                    <span class="card-title">Entities</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="TradeTypes" asp-action="Index" class="terraria-card">
                        <div class="card-icon"></div>
                        <span class="card-title">Trade Types</span>
                    </a>
                    <a asp-controller="CurrencyTypes" asp-action="Index" class="terraria-card">
                        <div class="card-icon"></div>
                        <span class="card-title">Currency Types</span>
                    </a>
                }
            </div>
        </aside>
    </div>

    <footer class="terraria-footer">
        <span>©2026-TerrariaDB</span>
        <div class="contact">
            contact us: karmodziregmont@gmail.com
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
