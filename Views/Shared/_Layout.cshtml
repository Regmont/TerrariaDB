<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TerrariaDB</title>
    <link rel="stylesheet" href="~/TerrariaDB.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="terraria-header">
        <a asp-controller="Home" asp-action="Index" class="terraria-logo">Terraria</a>
        <div class="auth-container">
            <partial name="_LoginPartial" />
        </div>
    </header>

    @RenderBody()

    <footer class="terraria-footer">
        <span>©2026-TerrariaDB</span>
        <div class="contact">
            contact us: karmodziregmont@gmail.com
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
