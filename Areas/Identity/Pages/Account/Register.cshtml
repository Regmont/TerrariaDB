@page
@model RegisterModel

@{
    ViewData["Title"] = "Register New Administrator";
}

<div class="login-page">
    <div class="login-container">
        <div class="login-header">
            <h1>Register New Administrator</h1>
        </div>

        <div class="login-card">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

                <div class="form-group">
                    <div class="label-text">Login</div>
                    <input asp-for="Input.Login" />
                </div>

                <div class="form-group">
                    <div class="label-text">Password</div>
                    <input asp-for="Input.Password" type="password" />
                </div>

                <div class="form-group">
                    <div class="label-text">Confirm Password</div>
                    <input asp-for="Input.ConfirmPassword" type="password" />
                </div>

                <button type="submit" class="login-button">REGISTER</button>
            </form>
        </div>
    </div>
</div>

<style>
    input, input:focus, input:active, input:hover {
        background-color: #1a1f2e !important;
        border: 2px solid #8b6b4d !important;
        color: #ffd700 !important;
        font-family: 'Courier New', monospace !important;
        font-size: 16px !important;
        width: 100% !important;
        box-sizing: border-box !important;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5) !important;
        outline: none !important;
    }

        input:focus {
            border-color: #c0a88c !important;
            background-color: #141229 !important;
        }

            input:focus:not(:placeholder-shown) {
                background-color: #0f1420 !important;
                border-color: #ffd700 !important;
            }

        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:active {
            background-color: #0f1420 !important;
            border-color: #ffd700 !important;
            -webkit-text-fill-color: #ffd700 !important;
            -webkit-box-shadow: 0 0 0px 1000px #0f1420 inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
